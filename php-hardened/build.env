# What a build of the Kipchak Runtime Image builds, read by every builder: the GitHub workflow
# (.github/workflows/build.yml) and Mamluk's own pipeline. The base images and the pinned tools are not here: they are
# the Dockerfile's ARG defaults, each pinned by digest or version, which every builder uses unchanged.
#
# The PHP release lines built. Each build takes the latest release of each line from php.net.
PHP_LINES="8.4 8.5"
# The Dockerfile targets each builder produces, in order. sources-set and runtime are built together, so that both use
# the same compile; build and alpine are built from the runtime image by digest (RUNTIME_SOURCE).
TARGETS="sources-set runtime build alpine"
